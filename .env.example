# --- Database Configuration ---
# Password for the SQL Server 'sa' user
DB_PASSWORD=YourStrongPassword123!
DB_NAME=SmartITSM

# --- Authentication ---
# Secret key for JWT token signing (should be a long random string)
JWT_SECRET=YourSuperSecretKeyForJWTSigningThatIsAtLeast32CharsLong

# These values match the backend appsettings structure.
JWT_ISSUER=SmartITSM
JWT_AUDIENCE=SmartITSM

# --- External APIs ---
# Your Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# --- Frontend URL used by backend links ---
# This is the URL users will open in their browser.
FRONTEND_BASE_URL=http://localhost:3000

# --- SMTP / Email Settings ---
# Use host.docker.internal if your SMTP server runs on your machine.
SMTP_HOST=host.docker.internal
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@smartitsm.com
SMTP_FROM_NAME=SmartITSM System
SMTP_ENABLE_SSL=false
SMTP_ENABLE_EMAILS=true

# --- Frontend Build Configuration ---
# The URL of the API that the browser will call
VITE_API_URL=http://localhost:8080
